+static uint8_t mc10_read_stack_byte(struct machine_mc10 *mp, unsigned A) {
+	uint8_t D = 0;
+	if (mp->cart) {
+		D = mp->cart->read(mp->cart, A, D);
+		if (mp->cart->SEL)
+			return D;
+	}
+	return mc10_read_byte(&mp->machine, A, D);
+}
+
 static void mc10_op_rts(struct machine *m) {
 	struct machine_mc10 *mp = (struct machine_mc10 *)m;
-	unsigned int new_pc = m->read_byte(m, mp->CPU->reg_sp + 1, 0) << 8;
-	new_pc |= m->read_byte(m, mp->CPU->reg_sp + 2, 0);
+	uint8_t high = mc10_read_stack_byte(mp, mp->CPU->reg_sp + 1);
+	uint8_t low = mc10_read_stack_byte(mp, mp->CPU->reg_sp + 2);
+	unsigned int new_pc = (high << 8) | low;
 	mp->CPU->reg_sp += 2;
 	mp->CPU->reg_pc = new_pc;
 }
